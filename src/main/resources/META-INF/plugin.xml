<idea-plugin>
    <id>io.github.einsnils.deplens</id>
    <name>DepLens</name>
    <vendor>EinsNils</vendor>
    <description><![CDATA[
        Browse Gradle dependencies per module grouped by vendor, see every path that pulls a dependency in,
        and check them for known vulnerabilities (OSV.dev, optional Sonatype OSS Index) with safe upgrade suggestions.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DepLens"
                    anchor="right"
                    icon="AllIcons.Nodes.PpLib"
                    factoryClass="io.github.einsnils.deplens.ui.DepLensToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                 instance="io.github.einsnils.deplens.settings.DepLensConfigurable"
                                 id="io.github.einsnils.deplens.settings"
                                 displayName="DepLens"/>
    </extensions>
</idea-plugin>
