<idea-plugin>
    <id>io.github.einsnils.deplens</id>
    <name>DepLens</name>
    <vendor>EinsNils</vendor>
    <description><![CDATA[
        <p><img src="https://raw.githubusercontent.com/EinsNils/DepLens/main/docs/assets/deplens-banner.png"
                alt="DepLens" width="560" height="280"></p>
        <p>Browse Gradle dependencies per module grouped by vendor, see every path that pulls a dependency in,
        and check them for known vulnerabilities (OSV.dev, optional Sonatype OSS Index) with safe upgrade suggestions.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DepLens"
                    anchor="right"
                    icon="AllIcons.Nodes.PpLib"
                    factoryClass="io.github.einsnils.deplens.ui.DepLensToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                 instance="io.github.einsnils.deplens.settings.DepLensConfigurable"
                                 id="io.github.einsnils.deplens.settings"
                                 displayName="DepLens"/>
    </extensions>
</idea-plugin>
